# O Caddy emite e renova o certificado HTTPS (Let's Encrypt) sozinho para DOMAIN.
{$DOMAIN} {
	encode zstd gzip

	# API no mesmo domínio do site, então o navegador não precisa de CORS
	@api path /v1/* /health /health/* /docs /docs/* /redoc /openapi.json
	handle @api {
		request_body {
			max_size 60MB
		}
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
