# Copie para .env e ajuste. Nunca versione o .env.
ENVIRONMENT=local
LOG_LEVEL=INFO

POSTGRES_USER=secury
POSTGRES_PASSWORD=secury
POSTGRES_DB=secury

# MinIO local; em produção use S3 e deixe S3_ENDPOINT_URL vazio
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=documents
S3_REGION=us-east-1

MAX_UPLOAD_MB=50
CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000
