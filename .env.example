# Copie para .env e ajuste. Nunca versione o .env.
#   cp .env.example .env
# Os valores abaixo servem para dev local. Na VPS, troque TODOS os marcados com [prod].

ENVIRONMENT=local
LOG_LEVEL=INFO
# Versão usada na tag das imagens (ex.: 0.1.0). Ajuda a voltar para a versão anterior.
APP_VERSION=local

# Serviços opcionais do compose. "storage" sobe o object storage local (RustFS).
# Para usar S3 gerenciado (AWS, Cloudflare R2...), deixe vazio: COMPOSE_PROFILES=
COMPOSE_PROFILES=storage

# --- Banco ---------------------------------------------------------------------
POSTGRES_USER=secury
POSTGRES_PASSWORD=secury            # [prod] gere com: openssl rand -hex 24
POSTGRES_DB=secury

# --- Object storage (API S3) ---------------------------------------------------
# Storage local do compose: não defina S3_ENDPOINT_URL (o compose usa http://storage:9000).
# S3 da AWS: S3_ENDPOINT_URL= (vazio). R2/outros: a URL do provedor.
# S3_ENDPOINT_URL=
S3_ACCESS_KEY=secury                # [prod] gere com: openssl rand -hex 12
S3_SECRET_KEY=secury-dev-secret     # [prod] gere com: openssl rand -hex 24
S3_BUCKET=documents
S3_REGION=us-east-1
# Criptografia em repouso (SSE-S3): o app pede AES256 e o storage cifra com a chave mestra.
# Deixe S3_SSE vazio só se o storage não suportar.
S3_SSE=AES256
# Chave mestra do storage local: 32 bytes em base64. [prod] gere com: openssl rand -base64 32
# Guarde-a junto com os backups: sem ela os arquivos do volume não podem ser lidos.
STORAGE_SSE_MASTER_KEY=ZGV2LWxvY2FsLXNvbWVudGUtcGFyYS10ZXN0ZXMtMDA=

# --- API key inicial (criada automaticamente pelo serviço migrate) ---------------
BOOTSTRAP_ORG=Dev
# Dev: chave fixa para colar no site. [prod] deixe vazio para gerar uma aleatória,
# que aparece uma vez em: docker compose logs migrate
BOOTSTRAP_API_KEY=ats_dev_local_somente_para_testes

# --- App -----------------------------------------------------------------------
MAX_UPLOAD_MB=50
WORKER_CONCURRENCY=2
CORS_ORIGINS=["http://localhost:3000"]
# URL da API vista pelo navegador (só dev; em prod o site chama o mesmo domínio)
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Só produção (docker-compose.prod.yml) ----------------------------------------
# Domínio apontado (DNS tipo A) para o IP da VPS. O Caddy emite o HTTPS sozinho.
DOMAIN=
